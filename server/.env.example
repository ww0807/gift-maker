# Keep this file free of real secrets. Configure actual values in veFaaS.
NODE_ENV=production
APP_ORIGIN=https://your-frontend-domain.example.com

# Server-only secrets. Do not expose these with a VITE_ prefix.
INVITE_TOKEN=replace-with-a-20-character-random-token
ARK_API_KEY=replace-with-ark-api-key
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
IMAGE_SEGMENTATION_ENDPOINT=replace-with-volcengine-segmentation-endpoint
IMAGE_SEGMENTATION_KEY=replace-with-segmentation-api-key

# TOS private bucket configuration.
TOS_REGION=cn-beijing
TOS_BUCKET=gift-maker-test
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_ACCESS_KEY_ID=replace-with-server-access-key
TOS_SECRET_ACCESS_KEY=replace-with-server-secret-key

# The async task function receives task IDs only and reloads task JSON from TOS.
GENERATOR_FUNCTION_NAME=gift-maker-generate-test
# The Web function uses the protected API Gateway route of the task function.
# Set the same random value in BOTH functions.
GENERATOR_INVOKE_URL=https://replace-with-task-invocation-endpoint
GENERATOR_INVOKE_TOKEN=replace-with-a-second-random-32-character-token

# Optional API override when Ark/MediaKit gateway paths differ by account.
ARK_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
